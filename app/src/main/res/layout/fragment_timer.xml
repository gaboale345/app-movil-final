<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temporizador de Estudio"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enfócate en tus asignaturas sin distracciones"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Selector de Modalidad (Libre vs Pomodoro) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_modo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:checkedButton="@id/btn_modo_libre"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_modo_libre"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Libre" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_modo_pomodoro"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Pomodoro" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Selector de Materia -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_materia"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Selecciona una Materia">

            <AutoCompleteTextView
                android:id="@+id/actv_materia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Tema -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_tema"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Tema o tarea a estudiar (opcional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Display Circular del Cronómetro (Rosa) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/primary_pink_light"
            app:cardCornerRadius="130dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_pink"
            app:strokeWidth="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_pomodoro_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="@color/primary_pink"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Trabajo • Ciclo 1/4"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_timer_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="00:00"
                    android:textColor="@color/primary_pink"
                    android:textSize="54sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tiempo_efectivo_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tiempo efectivo: 00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de Control (Iniciar, Pausar, Reanudar, Finalizar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_iniciar"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:backgroundTint="@color/primary_pink"
                android:text="INICIAR"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pausar_reanudar"
                android:layout_width="140dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/primary_blue"
                android:text="PAUSAR"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finalizar"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="140dp"
                android:layout_height="56dp"
                android:strokeColor="@color/status_red"
                android:text="FINALIZAR"
                android:textColor="@color/status_red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <!-- Botón de Registro Manual -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_registro_manual"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="+ Registrar sesión manual sin cronómetro"
            android:textColor="@color/primary_blue"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
